{
  "name": "ai-news-agent",
  "version": "1.0.0",
  "description": "AI News Agent - 基于 CodeBuddy Agent SDK 的全自动 AI 资讯抓取客户端 (Web + Electron)",
  "author": "AI News Agent",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n SERVER,CLIENT -c blue,green \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx server/index.ts",
    "dev:client": "vite",
    "server": "tsx server/index.ts",
    "build:server": "esbuild server/index.ts --bundle --platform=node --packages=external --format=cjs --outfile=dist-server/index.cjs --log-level=warning",
    "build": "vite build",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "electron:dev": "concurrently -k -n SERVER,ELECTRON -c blue,magenta \"npm run dev:server\" \"wait-on http://localhost:3000/api/health && electron .\"",
    "electron:build": "npm run build && npm run build:server && electron-builder",
    "dist": "npm run build && npm run build:server && electron-builder"
  },
  "dependencies": {
    "@tencent-ai/agent-sdk": "^0.3.305",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.12.1",
    "lucide-react": "^1.78.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.7",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.1",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.ainewsagent.app",
    "productName": "AI News Agent",
    "asar": true,
    "asarUnpack": [
      "node_modules/@tencent-ai/**"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "node_modules/**/*",
      "!node_modules/electron",
      "!node_modules/electron/**/*",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  }
}
